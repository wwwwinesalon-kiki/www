NEXT_PUBLIC_SITE_URL=
# Set to neon only after the fresh-start or migration SQL and Auth are verified.
BACKEND_PROVIDER=
# Neon server-only connection and managed Auth; never prefix these with NEXT_PUBLIC_.
NEON_DATABASE_URL=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
# Neon private S3-compatible Object Storage. Keep the bucket private.
AWS_ENDPOINT_URL_S3=
NEON_S3_REGION=
NEON_S3_ACCESS_KEY_ID=
NEON_S3_SECRET_ACCESS_KEY=
NEON_ARTICLE_BUCKET=www-article-images

# Legacy Supabase values remain needed only during the staged migration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
LINE_JOIN_URL=https://lin.ee/xWYPyBv
# Server-only: private article image streaming; never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
# Source URL used only by the one-time private-image migration script.
MIGRATION_SUPABASE_URL=
# Server-only. Required for Kaihipay course check and paid-member synchronization.
KAIHIPAY_API_TOKEN=
# Server-only random secret (at least 32 UTF-8 bytes), separate from CRON_SECRET.
# Regenerating it invalidates unclaimed email HMAC rows; plan a migration first.
KAIHIPAY_EMAIL_HMAC_SECRET=
# Required in Neon mode. Check the real course ID and recurring fee in Kaihipay;
# reconcile the approved customer total of 3,410 yen before setting these.
KAIHIPAY_MEMBERSHIP_COURSE_ID=
KAIHIPAY_EXPECTED_RECURRING_FEE_YEN=
CRON_SECRET=
